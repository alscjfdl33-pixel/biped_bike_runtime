<?xml version="1.0"?>
<sdf version="1.9">
  <world name="biped_bike_stairs">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3.0 3.0 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.0 3.0 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.28 0.30 0.32 1</ambient>
            <diffuse>0.38 0.40 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      The stair-climber's observed Gazebo travel direction is +X.  The three
      stacked boxes expose 6 cm treads with top heights of 1, 2, and 3 cm.
      The first riser starts at x=+0.12 m.
    -->
    <model name="stair_1">
      <static>true</static>
      <pose>0.27 0 0.005 0 0 0</pose>
      <link name="step_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.45 0.01</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.4</mu><mu2>1.4</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.45 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.18 0.05 1</ambient>
            <diffuse>0.82 0.34 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="stair_2">
      <static>true</static>
      <pose>0.30 0 0.010 0 0 0</pose>
      <link name="step_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.24 0.45 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.4</mu><mu2>1.4</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.24 0.45 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.52 0.22 0.06 1</ambient>
            <diffuse>0.90 0.40 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="stair_3">
      <static>true</static>
      <pose>0.33 0 0.015 0 0 0</pose>
      <link name="step_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 0.45 0.03</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.4</mu><mu2>1.4</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 0.45 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.60 0.26 0.08 1</ambient>
            <diffuse>0.96 0.46 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
